#!/usr/bin/env bash
# Tooling only: configure and exec the real Codex CLI. Codex owns every agent turn.
set -euo pipefail
umask 077
CTF_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CTF_HOME="$CTF_ROOT/.runtime/codex"
CTF_PROFILES="team cheap audit traffic patch mimo"
CTF_SYSTEM_SKILLS="imagegen openai-docs skill-creator skill-installer"

fail() { printf 'ctf-codex: %s\n' "$*" >&2; exit 2; }
toml_escape() {
  local CTF_VALUE="$1"
  CTF_VALUE="${CTF_VALUE//\\/\\\\}"
  CTF_VALUE="${CTF_VALUE//\"/\\\"}"
  CTF_VALUE="${CTF_VALUE//$'\n'/\\n}"
  CTF_VALUE="${CTF_VALUE//$'\r'/\\r}"
  CTF_VALUE="${CTF_VALUE//$'\t'/\\t}"
  printf '%s' "$CTF_VALUE"
}
# The default model is single-sourced from the canonical base config.
default_model() {
  sed -n 's/^model[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' \
    "$CTF_ROOT/config/codex/config.toml" | head -n 1
}
require_codex() {
  local CTF_CANDIDATE CTF_VERSION_OUTPUT CTF_MAJOR CTF_MINOR CTF_PATCH
  for CTF_CANDIDATE in "$(command -v codex 2>/dev/null || true)" \
    "$HOME"/AppData/Local/OpenAI/Codex/bin/*/codex.exe; do
    [ -x "$CTF_CANDIDATE" ] || continue
    CTF_VERSION_OUTPUT="$("$CTF_CANDIDATE" --version 2>/dev/null)" || continue
    [[ "$CTF_VERSION_OUTPUT" =~ ([0-9]+)\.([0-9]+)\.([0-9]+) ]] || continue
    CTF_MAJOR=$((10#${BASH_REMATCH[1]}))
    CTF_MINOR=$((10#${BASH_REMATCH[2]}))
    CTF_PATCH=$((10#${BASH_REMATCH[3]}))
    if [ "$CTF_MAJOR" -gt 0 ] || [ "$CTF_MINOR" -gt 159 ] || \
       { [ "$CTF_MINOR" -eq 159 ] && [ "$CTF_PATCH" -ge 2 ]; }; then
      CTF_CODEX_BIN="$CTF_CANDIDATE"
      return
    fi
  done
  fail 'Install Codex CLI >= 0.159.2.'
}
require_python() {
  CTF_PYTHON=python3
  local CTF_PY_VERSION CTF_PY_MAJOR CTF_PY_MINOR
  CTF_PY_VERSION="$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])' 2>/dev/null)" || {
    CTF_PYTHON=python
    CTF_PY_VERSION="$(python -c 'import sys; print("%d.%d" % sys.version_info[:2])' 2>/dev/null)" || fail 'Python 3.9+ is required.'
  }
  if [[ ! "$CTF_PY_VERSION" =~ ^([0-9]+)\.([0-9]+)$ ]]; then
    fail "Could not parse Python version: $CTF_PY_VERSION"
  fi
  CTF_PY_MAJOR=$((10#${BASH_REMATCH[1]}))
  CTF_PY_MINOR=$((10#${BASH_REMATCH[2]}))
  if [ "$CTF_PY_MAJOR" -lt 3 ] || { [ "$CTF_PY_MAJOR" -eq 3 ] && [ "$CTF_PY_MINOR" -lt 9 ]; }; then
    fail "Python 3.9+ is required; found $CTF_PY_VERSION."
  fi
  [ "${1:-}" = quiet ] || printf 'Python %s: minimum requirement met\n' "$CTF_PY_VERSION"
}
reject_project_config() {
  [ ! -e "$CTF_ROOT/.codex/config.toml" ] && [ ! -L "$CTF_ROOT/.codex/config.toml" ] || \
    fail 'Remove .codex/config.toml from this repository before launch; it can override the isolated provider.'
}
write_config() {
  # Atomic install so a concurrent Codex process never reads a partial config.
  local CTF_DEST="$1" CTF_TMP
  CTF_TMP="$CTF_DEST.tmp.$$"
  cat > "$CTF_TMP"
  chmod 600 "$CTF_TMP"
  mv -f "$CTF_TMP" "$CTF_DEST"
}
install_file() {
  local CTF_SOURCE="$1" CTF_DEST="$2" CTF_TMP
  mkdir -p "$(dirname "$CTF_DEST")"
  cmp -s "$CTF_SOURCE" "$CTF_DEST" && return 0
  CTF_TMP="$CTF_DEST.tmp.$$"
  cp -p "$CTF_SOURCE" "$CTF_TMP"
  mv -f "$CTF_TMP" "$CTF_DEST"
}
setup() {
  require_codex
  mkdir -p "$CTF_HOME/skills" "$CTF_HOME/agents" "$CTF_HOME/prompts"
  chmod 700 "$CTF_ROOT/.runtime" "$CTF_HOME"
  local CTF_CONFIG CTF_TMP CTF_SKILL_DIR CTF_SKILL CTF_SKILL_TOML CTF_ASSET
  local CTF_TOML_ROOT CTF_SED_ROOT CTF_ENTRY
  CTF_TOML_ROOT="$(toml_escape "$CTF_ROOT")"
  CTF_SED_ROOT="$(printf '%s' "$CTF_TOML_ROOT" | sed 's/[&|\\]/\\&/g')"
  # Base user config plus native per-skill overrides that suppress unrelated
  # personal and bundled skills. CODEX_HOME alone does not hide ~/.agents/skills.
  {
    sed "s|@CTF_ROOT@|$CTF_SED_ROOT|g" "$CTF_ROOT/config/codex/config.toml"
    for CTF_SKILL in "$HOME"/.agents/skills/*/SKILL.md; do
      [ -f "$CTF_SKILL" ] || continue
      CTF_SKILL_TOML="$(toml_escape "$CTF_SKILL")"
      printf '\n[[skills.config]]\npath = "%s"\nenabled = false\n' "$CTF_SKILL_TOML"
    done
    for CTF_SKILL in $CTF_SYSTEM_SKILLS; do
      CTF_SKILL_TOML="$(toml_escape "$CTF_HOME/skills/.system/$CTF_SKILL/SKILL.md")"
      printf '\n[[skills.config]]\npath = "%s"\nenabled = false\n' "$CTF_SKILL_TOML"
    done
    # Trust this repository so its AGENTS.md is loaded in the Codex session.
    printf '\n[projects."%s"]\ntrust_level = "trusted"\n' "$CTF_TOML_ROOT"
  } | write_config "$CTF_HOME/config.toml"
  # Replace managed assets atomically in place. Never remove assets another
  # active Codex process may still be reading during a concurrent launch.
  for CTF_CONFIG in "$CTF_ROOT"/config/codex/*.config.toml; do
    [ -e "$CTF_CONFIG" ] || continue
    sed "s|@CTF_ROOT@|$CTF_SED_ROOT|g" "$CTF_CONFIG" | write_config "$CTF_HOME/$(basename "$CTF_CONFIG")"
  done
  for CTF_SKILL_DIR in "$CTF_ROOT"/skills/ad-ctf-*; do
    [ -d "$CTF_SKILL_DIR" ] || continue
    while IFS= read -r -d '' CTF_ASSET; do
      install_file "$CTF_ASSET" "$CTF_HOME/skills/${CTF_ASSET#"$CTF_ROOT/skills/"}"
    done < <(find "$CTF_SKILL_DIR" -type f -print0)
  done
  for CTF_ASSET in "$CTF_ROOT"/config/agents/*.toml; do
    [ -f "$CTF_ASSET" ] || continue
    install_file "$CTF_ASSET" "$CTF_HOME/agents/$(basename "$CTF_ASSET")"
  done
  # Install the native custom prompts so /prompts:<name> works in the TUI.
  for CTF_ASSET in "$CTF_ROOT"/prompts/*.md; do
    [ -f "$CTF_ASSET" ] || continue
    install_file "$CTF_ASSET" "$CTF_HOME/prompts/$(basename "$CTF_ASSET")"
  done
}
usage() {
  cat <<'EOF'
Usage: ./codex-ctf [PROMPT]
       bin/ctf-codex setup | doctor | models [MODEL] | models --zdr MODEL... | models --free-zdr | smoke
       bin/ctf-codex deploy --config PRIVATE_JSON COMMAND [OPTIONS]
       bin/ctf-codex [team|brrrr|run|audit|traffic|patch] [OPTIONS] [PROMPT]
       bin/ctf-codex resume [OPTIONS] [--last|SESSION_ID] [PROMPT]
Options: --profile NAME --model VENDOR/MODEL --exec --json
         --output FILE --effort low|medium|high|xhigh|max
Profiles: team, cheap, audit, traffic, patch, mimo
`run` is a raw single-agent launch of the cheap profile with no workflow prompt.
`brrrr` is a native Codex team surge (up to 20 agents).
In the TUI use /prompts:brrrr or /prompts:chillax to switch modes.
No phase gates. No agent loop in this script. Personal Codex config is untouched.
EOF
}

CTF_COMMAND="${1:-help}"
if [ "$#" -gt 0 ]; then shift; fi
case "$CTF_COMMAND" in
  help|-h|--help) usage; exit 0 ;;
  setup) setup; printf 'Installed isolated config and skills: %s\n' "$CTF_HOME"; exit 0 ;;
  doctor)
    require_python
    setup
    env CODEX_HOME="$CTF_HOME" "$CTF_CODEX_BIN" --version
    mkdir -p "$CTF_ROOT/.runtime/validation"
    # Strict config validation without credentials, so this cannot infer.
    for CTF_PROFILE in $CTF_PROFILES; do
      CTF_OUT="$(env -u OPENROUTER_API_KEY CODEX_HOME="$CTF_HOME" "$CTF_CODEX_BIN" --strict-config --profile "$CTF_PROFILE" exec \
        --skip-git-repo-check --sandbox read-only \
        'Configuration validation only.' 2>&1)" || true
      case "$CTF_OUT" in
        *'Error loading config.toml'*)
          printf '%s\n' "$CTF_OUT" >&2
          fail "Profile $CTF_PROFILE has invalid configuration." ;;
      esac
      printf '%s: strict-config OK\n' "$CTF_PROFILE"
    done
    # Native prompt and skill discovery, no inference.
    for CTF_PROFILE in $CTF_PROFILES; do
      if ! env CODEX_HOME="$CTF_HOME" "$CTF_CODEX_BIN" --profile "$CTF_PROFILE" debug prompt-input \
          'Validate native prompt and skill discovery; no inference.' \
          > "$CTF_ROOT/.runtime/validation/$CTF_PROFILE.json" \
          2> "$CTF_ROOT/.runtime/validation/$CTF_PROFILE.stderr"; then
        cat "$CTF_ROOT/.runtime/validation/$CTF_PROFILE.stderr" >&2
        fail "Profile $CTF_PROFILE failed native prompt construction."
      fi
      printf '%s: native prompt/skill discovery OK\n' "$CTF_PROFILE"
    done
    # Managed assets must match their sources exactly.
    CTF_EXPECTED_AGENTS="$(find "$CTF_ROOT/config/agents" -maxdepth 1 -name '*.toml' 2>/dev/null | wc -l | tr -d ' ')"
    CTF_INSTALLED_AGENTS="$(find "$CTF_HOME/agents" -maxdepth 1 -name 'ctf-*.toml' 2>/dev/null | wc -l | tr -d ' ')"
    [ "$CTF_EXPECTED_AGENTS" = "$CTF_INSTALLED_AGENTS" ] || fail "Installed agents ($CTF_INSTALLED_AGENTS) do not match source ($CTF_EXPECTED_AGENTS)."
    CTF_EXPECTED_SKILLS="$(find "$CTF_ROOT/skills" -maxdepth 1 -type d -name 'ad-ctf-*' 2>/dev/null | wc -l | tr -d ' ')"
    CTF_INSTALLED_SKILLS="$(find "$CTF_HOME/skills" -maxdepth 1 -type d -name 'ad-ctf-*' 2>/dev/null | wc -l | tr -d ' ')"
    [ "$CTF_EXPECTED_SKILLS" = "$CTF_INSTALLED_SKILLS" ] || fail "Installed skills ($CTF_INSTALLED_SKILLS) do not match source ($CTF_EXPECTED_SKILLS)."
    printf 'Managed assets: %s agents, %s skills\n' "$CTF_INSTALLED_AGENTS" "$CTF_INSTALLED_SKILLS"
    # Native environment diagnosis (informational; platform-specific warnings allowed).
    env CODEX_HOME="$CTF_HOME" "$CTF_CODEX_BIN" doctor --no-color --summary || \
      printf 'ctf-codex: native doctor reported warnings; review above.\n' >&2
    for CTF_TOOL in docker tshark capinfos rg git; do
      command -v "$CTF_TOOL" || printf '%s: optional tool unavailable\n' "$CTF_TOOL"
    done
    printf 'No model inference performed. Live check: bin/ctf-codex smoke\n'; exit 0 ;;
  models)
    require_python quiet
    if [ "$#" -eq 0 ]; then
      set -- "$(default_model)"
    fi
    exec "$CTF_PYTHON" "$CTF_ROOT/scripts/model-info.py" "$@" ;;
  deploy)
    require_python quiet
    exec "$CTF_PYTHON" "$CTF_ROOT/scripts/deployment.py" "$@" ;;
  smoke)
    mkdir -p "$CTF_ROOT/.runtime/smoke"
    printf 'CTF_SMOKE_LOCAL_FILE_OK\n' > "$CTF_ROOT/.runtime/smoke/probe.txt"
    rm -f "$CTF_ROOT/.runtime/smoke/verified.txt" "$CTF_ROOT/.runtime/smoke/answer.txt"
    "$CTF_ROOT/bin/ctf-codex" run --exec \
      --output "$CTF_ROOT/.runtime/smoke/answer.txt" \
      'Use the shell tool to read .runtime/smoke/probe.txt. Use apply_patch to create .runtime/smoke/verified.txt containing exactly CTF_SMOKE_LOCAL_FILE_OK followed by a newline. Read that file with the shell tool. Reply exactly CTF_SMOKE_OK. Do not inspect other files or run other commands.'
    cmp -s "$CTF_ROOT/.runtime/smoke/probe.txt" "$CTF_ROOT/.runtime/smoke/verified.txt" || \
      fail 'Smoke did not reproduce the local file content.'
    [ "$(cat "$CTF_ROOT/.runtime/smoke/answer.txt")" = 'CTF_SMOKE_OK' ] || fail 'Smoke final answer mismatch.'
    printf 'Verified OpenRouter inference, local shell and file-result replay.\n'; exit 0 ;;
  team|brrrr|run|audit|traffic|patch|resume) ;;
  *) usage; fail "Unknown command: $CTF_COMMAND" ;;
esac

CTF_PROFILE=cheap
case "$CTF_COMMAND" in team|brrrr) CTF_PROFILE=team ;; audit|traffic|patch) CTF_PROFILE="$CTF_COMMAND" ;; esac
if [ "$CTF_COMMAND" = resume ]; then CTF_PROFILE=team; fi
CTF_EXEC=false
CTF_JSON=false
CTF_OUTPUT=''
CTF_MODEL=''
CTF_EFFORT=''
CTF_PROFILE_GIVEN=false
CTF_PROMPT=''
CTF_RESUME_ARGS=()
CTF_RESUME_SELECTOR=false
while [ "$#" -gt 0 ]; do
  case "$1" in
    --profile|--output|--model|--effort)
      [ "$#" -ge 2 ] || fail "Missing value for $1"
      case "$1" in
        --profile) CTF_PROFILE="$2"; CTF_PROFILE_GIVEN=true ;;
        --output) CTF_OUTPUT="$2" ;;
        --model) CTF_MODEL="$2" ;;
        --effort) CTF_EFFORT="$2" ;;
      esac
      shift 2 ;;
    --exec) CTF_EXEC=true; shift ;;
    --json) CTF_JSON=true; shift ;;
    --)
      shift
      if [ "$CTF_COMMAND" = resume ]; then
        [ "$CTF_RESUME_SELECTOR" = true ] || fail 'Resume prompt requires --last or a session ID first.'
        CTF_RESUME_ARGS+=(-- "$*")
      else
        CTF_PROMPT="$*"
      fi
      break ;;
    -*)
      if [ "$CTF_COMMAND" = resume ]; then
        case "$1" in
          --last)
            [ "$CTF_RESUME_SELECTOR" = false ] || fail 'Choose either --last or one session ID.'
            CTF_RESUME_ARGS+=("$1"); CTF_RESUME_SELECTOR=true; shift ;;
          *) fail 'resume accepts only --last as a native option; provider, approval, and remote overrides are not allowed.' ;;
        esac
      else
        fail "Unknown option: $1"
      fi
      ;;
    *)
      if [ "$CTF_COMMAND" = resume ]; then
        if [ "$CTF_RESUME_SELECTOR" = false ]; then
          CTF_RESUME_ARGS+=("$1"); CTF_RESUME_SELECTOR=true; shift
        else
          CTF_RESUME_ARGS+=("$*"); break
        fi
      else
        CTF_PROMPT="$*"; break
      fi
      ;;
  esac
done
[ "$CTF_COMMAND" != brrrr ] || {
  [ "$CTF_PROFILE_GIVEN" = false ] || printf 'ctf-codex: brrrr always runs the team profile; ignoring --profile.\n' >&2
  CTF_PROFILE=team
}
case "$CTF_PROFILE" in team|cheap|audit|traffic|patch|mimo) ;; *) fail 'Unknown profile.' ;; esac
if [ -n "$CTF_EFFORT" ]; then
  case "$CTF_EFFORT" in low|medium|high|xhigh|max) ;; *) fail 'Unknown reasoning effort.' ;; esac
fi
if [ -n "$CTF_MODEL" ]; then
  [[ "$CTF_MODEL" =~ ^[a-zA-Z0-9_.~-]+/[a-zA-Z0-9_.:~-]+$ ]] || fail 'Use a complete OpenRouter slug.'
fi
if [ "$CTF_COMMAND" = brrrr ]; then
  CTF_PROMPT="$(cat "$CTF_ROOT/prompts/brrrr.md")

$CTF_PROMPT"
elif [ "$CTF_COMMAND" != run ] && [ "$CTF_COMMAND" != team ]; then
  if [ "$CTF_COMMAND" != resume ]; then
    CTF_PROMPT="$(cat "$CTF_ROOT/prompts/$CTF_COMMAND.md")

$CTF_PROMPT"
  fi
fi
require_python quiet
setup
[ -n "${OPENROUTER_API_KEY:-}" ] || fail 'Export OPENROUTER_API_KEY before launch.'
reject_project_config
CTF_ARGS=(--no-daemon --strict-config --cd "$CTF_ROOT" --profile "$CTF_PROFILE"
  -c 'model_provider="openrouter"' -c 'model_providers.openrouter.base_url="https://openrouter.ai/api/v1"')
if [ "$CTF_COMMAND" = team ] || [ "$CTF_COMMAND" = brrrr ]; then
  CTF_ARGS+=(-c 'features.multi_agent=true' -c 'agents.enabled=true' -c 'agents.max_concurrent_threads_per_session=20')
fi
[ -z "$CTF_MODEL" ] || CTF_ARGS+=(--model "$CTF_MODEL")
[ -z "$CTF_EFFORT" ] || CTF_ARGS+=(-c "model_reasoning_effort=\"$CTF_EFFORT\"")
if [ "$CTF_COMMAND" = team ] || [ "$CTF_COMMAND" = brrrr ]; then
  mkdir -p "$CTF_ROOT/.runtime/coordination/inbox" "$CTF_ROOT/.runtime/flags/inbox"
  if [ "$CTF_COMMAND" = brrrr ]; then
    CTF_TEAM_SCOPE='Surge launch: up to twenty spawned agents are authorized; scale only for distinct useful backlog.'
  else
    CTF_TEAM_SCOPE='Team launch: start five workers initially and expand only when distinct useful backlog warrants it.'
  fi
  if [ -n "$CTF_PROMPT" ]; then
    CTF_PROMPT="$CTF_PROMPT

Repository tooling root: $CTF_ROOT
Use scripts at that absolute root. $CTF_TEAM_SCOPE"
  fi
fi
if [ "$CTF_COMMAND" = resume ]; then
  if $CTF_EXEC; then
    [ "$CTF_RESUME_SELECTOR" = true ] || fail 'resume --exec requires --last or a session ID.'
    CTF_ARGS+=(exec --sandbox workspace-write --color never --skip-git-repo-check resume)
    $CTF_JSON && CTF_ARGS+=(--json)
    [ -z "$CTF_OUTPUT" ] || CTF_ARGS+=(--output-last-message "$CTF_OUTPUT")
    CTF_ARGS+=("${CTF_RESUME_ARGS[@]}")
  else
    $CTF_JSON && fail 'interactive resume does not support --json.'
    [ -z "$CTF_OUTPUT" ] || fail 'interactive resume does not support --output.'
    CTF_ARGS+=(resume "${CTF_RESUME_ARGS[@]}")
  fi
elif $CTF_EXEC; then
  CTF_ARGS+=(exec --sandbox workspace-write --color never --skip-git-repo-check)
  $CTF_JSON && CTF_ARGS+=(--json)
  [ -z "$CTF_OUTPUT" ] || CTF_ARGS+=(--output-last-message "$CTF_OUTPUT")
elif $CTF_JSON || [ -n "$CTF_OUTPUT" ]; then
  fail '--json and --output require --exec.'
fi
[ -z "$CTF_PROMPT" ] || CTF_ARGS+=(-- "$CTF_PROMPT")
# Watch for a private organizer config, including one added after launch. The
# submitter stays tied to the Codex process and logs metadata only.
CTF_AUTO_PID=''
CTF_SUBMISSION_CONFIG_PATH="${CTF_SUBMISSION_CONFIG:-$CTF_ROOT/.runtime/flags/submission.json}"
case "$CTF_SUBMISSION_CONFIG_PATH" in /*) ;; *) CTF_SUBMISSION_CONFIG_PATH="$CTF_ROOT/$CTF_SUBMISSION_CONFIG_PATH" ;; esac
mkdir -p "$CTF_ROOT/.runtime/flags"
chmod 700 "$CTF_ROOT/.runtime/flags"
CTF_SUBMISSION_ADAPTER="${CTF_SUBMISSION_ADAPTER:-$CTF_ROOT/scripts/submit-http.py}"
(
  cd "$CTF_ROOT"
  CTF_PREFLIGHT_WARNED=false
  while :; do
    if [ -f "$CTF_SUBMISSION_CONFIG_PATH" ]; then
      require_python quiet
      if env -u OPENROUTER_API_KEY -u OPENAI_API_KEY -u CODEX_API_KEY \
          CTF_SUBMISSION_CONFIG="$CTF_SUBMISSION_CONFIG_PATH" "$CTF_PYTHON" \
          "$CTF_SUBMISSION_ADAPTER" --check >/dev/null 2>&1; then
        exec env -u OPENROUTER_API_KEY -u OPENAI_API_KEY -u CODEX_API_KEY \
          CTF_SUBMISSION_CONFIG="$CTF_SUBMISSION_CONFIG_PATH" "$CTF_PYTHON" \
          "$CTF_ROOT/scripts/flag-ledger.py" --db "$CTF_ROOT/.runtime/flags/ledger.sqlite3" \
          auto --adapter "$CTF_SUBMISSION_ADAPTER"
      fi
      if [ "$CTF_PREFLIGHT_WARNED" = false ]; then
        printf 'ctf-codex: local submission preflight failed; waiting for valid config.\n' >&2
        CTF_PREFLIGHT_WARNED=true
      fi
    fi
    sleep 1
  done
) >> "$CTF_ROOT/.runtime/flags/auto-submit.log" 2>&1 &
CTF_AUTO_PID=$!
trap 'kill -TERM "$CTF_AUTO_PID" 2>/dev/null || true; wait "$CTF_AUTO_PID" 2>/dev/null || true' EXIT
# The provider reads OPENROUTER_API_KEY; tool subprocesses filter it via config.
env -u OPENAI_API_KEY -u CODEX_API_KEY \
  CODEX_HOME="$CTF_HOME" "$CTF_PYTHON" "$CTF_ROOT/scripts/openrouter-fallback.py" \
  "$CTF_CODEX_BIN" "${CTF_ARGS[@]}"
