#!/usr/bin/env bash
# Tooling only: configure and exec the real Codex CLI. Codex owns every agent turn.
set -euo pipefail
umask 077
CTF_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CTF_HOME="$CTF_ROOT/.runtime/codex"
CTF_PROFILES="team cheap audit traffic patch deepseek-cheap deepseek-audit"
CTF_SYSTEM_SKILLS="imagegen openai-docs skill-creator skill-installer"

fail() { printf 'ctf-codex: %s\n' "$*" >&2; exit 2; }
toml_escape() {
  local CTF_VALUE="$1"
  CTF_VALUE="${CTF_VALUE//\\/\\\\}"
  CTF_VALUE="${CTF_VALUE//\"/\\\"}"
  CTF_VALUE="${CTF_VALUE//$'\n'/\\n}"
  CTF_VALUE="${CTF_VALUE//$'\r'/\\r}"
  CTF_VALUE="${CTF_VALUE//$'\t'/\\t}"
  printf '%s' "$CTF_VALUE"
}
# The default model is single-sourced from the canonical base config.
default_model() {
  sed -n 's/^model[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' \
    "$CTF_ROOT/config/codex/config.toml" | head -n 1
}
require_codex() {
  command -v codex >/dev/null || fail 'Install Codex CLI >= 0.159.2.'
  local CTF_VERSION_OUTPUT CTF_MAJOR CTF_MINOR CTF_PATCH
  CTF_VERSION_OUTPUT="$(codex --version 2>/dev/null)" || fail 'Could not read Codex CLI version.'
  if [[ ! "$CTF_VERSION_OUTPUT" =~ ([0-9]+)\.([0-9]+)\.([0-9]+) ]]; then
    fail "Could not parse Codex CLI version: $CTF_VERSION_OUTPUT"
  fi
  CTF_MAJOR=$((10#${BASH_REMATCH[1]}))
  CTF_MINOR=$((10#${BASH_REMATCH[2]}))
  CTF_PATCH=$((10#${BASH_REMATCH[3]}))
  if [ "$CTF_MAJOR" -lt 0 ] || { [ "$CTF_MAJOR" -eq 0 ] && [ "$CTF_MINOR" -lt 159 ]; } || \
     { [ "$CTF_MAJOR" -eq 0 ] && [ "$CTF_MINOR" -eq 159 ] && [ "$CTF_PATCH" -lt 2 ]; }; then
    fail "Codex CLI >= 0.159.2 is required; found $CTF_VERSION_OUTPUT."
  fi
}
# Project-local .codex/config.toml is loaded for trusted projects, and a
# workspace inherits the repository root's trust. Untrusted challenge source is
# agent-writable there, so drop any planted project config before every launch.
sanitize_project_config() {
  local CTF_DIR="$1"
  [ -n "$CTF_DIR" ] && [ -d "$CTF_DIR/.codex" ] || return 0
  rm -rf "$CTF_DIR/.codex"
}
write_config() {
  # Atomic install so a concurrent Codex process never reads a partial config.
  local CTF_DEST="$1" CTF_TMP
  CTF_TMP="$CTF_DEST.tmp.$$"
  cat > "$CTF_TMP"
  chmod 600 "$CTF_TMP"
  mv -f "$CTF_TMP" "$CTF_DEST"
}
setup() {
  require_codex
  mkdir -p "$CTF_HOME/skills" "$CTF_HOME/agents" "$CTF_HOME/prompts"
  chmod 700 "$CTF_ROOT/.runtime" "$CTF_HOME"
  local CTF_CONFIG CTF_TMP CTF_SKILL_DIR CTF_SKILL CTF_SKILL_TOML
  local CTF_TOML_ROOT CTF_SED_ROOT CTF_ENTRY
  CTF_TOML_ROOT="$(toml_escape "$CTF_ROOT")"
  CTF_SED_ROOT="$(printf '%s' "$CTF_TOML_ROOT" | sed 's/[&|\\]/\\&/g')"
  # Base user config plus native per-skill overrides that suppress unrelated
  # personal and bundled skills. CODEX_HOME alone does not hide ~/.agents/skills.
  {
    sed "s|@CTF_ROOT@|$CTF_SED_ROOT|g" "$CTF_ROOT/config/codex/config.toml"
    for CTF_SKILL in "$HOME"/.agents/skills/*/SKILL.md; do
      [ -f "$CTF_SKILL" ] || continue
      CTF_SKILL_TOML="$(toml_escape "$CTF_SKILL")"
      printf '\n[[skills.config]]\npath = "%s"\nenabled = false\n' "$CTF_SKILL_TOML"
    done
    for CTF_SKILL in $CTF_SYSTEM_SKILLS; do
      CTF_SKILL_TOML="$(toml_escape "$CTF_HOME/skills/.system/$CTF_SKILL/SKILL.md")"
      printf '\n[[skills.config]]\npath = "%s"\nenabled = false\n' "$CTF_SKILL_TOML"
    done
    # This launcher configures the repository and workspaces the user requested.
    printf '\n[projects."%s"]\ntrust_level = "trusted"\n' "$CTF_TOML_ROOT"
  } | write_config "$CTF_HOME/config.toml"
  # Profile files are fully generated; rewrite from scratch and drop stale ones.
  for CTF_CONFIG in "$CTF_HOME"/*.config.toml; do
    [ -e "$CTF_CONFIG" ] || continue
    rm -f "$CTF_CONFIG"
  done
  for CTF_CONFIG in "$CTF_ROOT"/config/codex/*.config.toml; do
    [ -e "$CTF_CONFIG" ] || continue
    sed "s|@CTF_ROOT@|$CTF_SED_ROOT|g" "$CTF_CONFIG" | write_config "$CTF_HOME/$(basename "$CTF_CONFIG")"
  done
  # Remove only generated CTF assets so deleted source files cannot linger.
  for CTF_SKILL_DIR in "$CTF_HOME"/skills/ad-ctf-*; do
    [ -d "$CTF_SKILL_DIR" ] || continue
    rm -rf "$CTF_SKILL_DIR"
  done
  for CTF_ENTRY in "$CTF_HOME"/agents/ctf-*.toml; do
    [ -f "$CTF_ENTRY" ] || continue
    rm -f "$CTF_ENTRY"
  done
  for CTF_SKILL_DIR in "$CTF_ROOT"/skills/ad-ctf-*; do
    cp -R "$CTF_SKILL_DIR" "$CTF_HOME/skills/"
  done
  cp "$CTF_ROOT"/config/agents/*.toml "$CTF_HOME/agents/"
  # Install the native custom prompts so /prompts:<name> works in the TUI.
  cp "$CTF_ROOT"/prompts/*.md "$CTF_HOME/prompts/"
  # Drop project config an agent may have planted in an agent-writable workspace.
  for CTF_ENTRY in "$CTF_ROOT"/workspaces/*; do
    [ -d "$CTF_ENTRY" ] || continue
    sanitize_project_config "$CTF_ENTRY"
  done
}
usage() {
  cat <<'EOF'
Usage: bin/ctf-codex setup | doctor | models [MODEL] | init SERVICE | smoke
       bin/ctf-codex [team|brrr|run|audit|traffic|patch] [OPTIONS] [PROMPT]
Options: --workspace DIR --profile NAME --model VENDOR/MODEL --exec --json
         --output FILE --effort low|medium|high|xhigh|max --network
Profiles: team, cheap, audit, traffic, patch, deepseek-cheap, deepseek-audit
`run` is a raw single-agent launch of the cheap profile with no workflow prompt.
`brrr` is a native Codex team surge (up to 20 agents).
In the TUI use /prompts:audit, /prompts:traffic, /prompts:patch, /prompts:team or /prompts:brrr.
No phase gates. No agent loop in this script. Personal Codex config is untouched.
EOF
}

CTF_COMMAND="${1:-help}"
if [ "$#" -gt 0 ]; then shift; fi
case "$CTF_COMMAND" in
  help|-h|--help) usage; exit 0 ;;
  init)
    CTF_SERVICE="${1:-}"
    [[ "$CTF_SERVICE" =~ ^[a-z0-9][a-z0-9_-]{0,63}$ ]] || fail 'Use a simple lowercase service name.'
    CTF_WORKSPACE="$CTF_ROOT/workspaces/$CTF_SERVICE"
    [ ! -e "$CTF_WORKSPACE" ] || fail 'Workspace exists; preserving existing evidence.'
    mkdir -p "$CTF_WORKSPACE"/{source,evidence/raw,evidence/derived,findings,patches,verification,coordination/inbox,flags/inbox}
    sed "s/@SERVICE@/$CTF_SERVICE/g" "$CTF_ROOT/templates/service.toml" > "$CTF_WORKSPACE/service.toml"
    sed "s/@SERVICE@/$CTF_SERVICE/g" "$CTF_ROOT/templates/team.toml" > "$CTF_WORKSPACE/team.toml"
    cp "$CTF_ROOT/templates/service-AGENTS.md" "$CTF_WORKSPACE/AGENTS.md"
    printf '%s\n' "$CTF_WORKSPACE"; exit 0 ;;
  setup) setup; printf 'Installed isolated config and skills: %s\n' "$CTF_HOME"; exit 0 ;;
  doctor)
    setup
    env CODEX_HOME="$CTF_HOME" codex --version
    mkdir -p "$CTF_ROOT/.runtime/validation"
    # Strict config validation with inference impossible (auth is forced to fail).
    for CTF_PROFILE in $CTF_PROFILES; do
      CTF_OUT="$(env CODEX_HOME="$CTF_HOME" codex --strict-config --profile "$CTF_PROFILE" exec \
        --skip-git-repo-check --sandbox read-only \
        -c 'model_providers.openrouter.auth.command="/bin/false"' \
        'Configuration validation only.' 2>&1)" || true
      case "$CTF_OUT" in
        *'Error loading config.toml'*)
          printf '%s\n' "$CTF_OUT" >&2
          fail "Profile $CTF_PROFILE has invalid configuration." ;;
      esac
      printf '%s: strict-config OK\n' "$CTF_PROFILE"
    done
    # Native prompt and skill discovery, no inference.
    for CTF_PROFILE in $CTF_PROFILES; do
      if ! env CODEX_HOME="$CTF_HOME" codex --profile "$CTF_PROFILE" debug prompt-input \
          'Validate native prompt and skill discovery; no inference.' \
          > "$CTF_ROOT/.runtime/validation/$CTF_PROFILE.json" \
          2> "$CTF_ROOT/.runtime/validation/$CTF_PROFILE.stderr"; then
        cat "$CTF_ROOT/.runtime/validation/$CTF_PROFILE.stderr" >&2
        fail "Profile $CTF_PROFILE failed native prompt construction."
      fi
      printf '%s: native prompt/skill discovery OK\n' "$CTF_PROFILE"
    done
    # Managed assets must match their sources exactly.
    CTF_EXPECTED_AGENTS="$(find "$CTF_ROOT/config/agents" -maxdepth 1 -name '*.toml' 2>/dev/null | wc -l | tr -d ' ')"
    CTF_INSTALLED_AGENTS="$(find "$CTF_HOME/agents" -maxdepth 1 -name 'ctf-*.toml' 2>/dev/null | wc -l | tr -d ' ')"
    [ "$CTF_EXPECTED_AGENTS" = "$CTF_INSTALLED_AGENTS" ] || fail "Installed agents ($CTF_INSTALLED_AGENTS) do not match source ($CTF_EXPECTED_AGENTS)."
    CTF_EXPECTED_SKILLS="$(find "$CTF_ROOT/skills" -maxdepth 1 -type d -name 'ad-ctf-*' 2>/dev/null | wc -l | tr -d ' ')"
    CTF_INSTALLED_SKILLS="$(find "$CTF_HOME/skills" -maxdepth 1 -type d -name 'ad-ctf-*' 2>/dev/null | wc -l | tr -d ' ')"
    [ "$CTF_EXPECTED_SKILLS" = "$CTF_INSTALLED_SKILLS" ] || fail "Installed skills ($CTF_INSTALLED_SKILLS) do not match source ($CTF_EXPECTED_SKILLS)."
    printf 'Managed assets: %s agents, %s skills\n' "$CTF_INSTALLED_AGENTS" "$CTF_INSTALLED_SKILLS"
    # Native environment diagnosis (informational; platform-specific warnings allowed).
    env CODEX_HOME="$CTF_HOME" codex doctor --no-color --summary || \
      printf 'ctf-codex: native doctor reported warnings; review above.\n' >&2
    for CTF_TOOL in docker tshark capinfos rg git; do
      command -v "$CTF_TOOL" || printf '%s: optional tool unavailable\n' "$CTF_TOOL"
    done
    printf 'No model inference performed. Live check: bin/ctf-codex smoke\n'; exit 0 ;;
  models)
    if [ "$#" -eq 0 ]; then
      set -- "$(default_model)"
    fi
    exec python3 "$CTF_ROOT/scripts/model-info.py" "$@" ;;
  smoke)
    mkdir -p "$CTF_ROOT/.runtime/smoke"
    printf 'CTF_SMOKE_LOCAL_FILE_OK\n' > "$CTF_ROOT/.runtime/smoke/probe.txt"
    rm -f "$CTF_ROOT/.runtime/smoke/verified.txt" "$CTF_ROOT/.runtime/smoke/answer.txt"
    "$CTF_ROOT/bin/ctf-codex" run --workspace "$CTF_ROOT/.runtime/smoke" --exec \
      --output "$CTF_ROOT/.runtime/smoke/answer.txt" \
      'Use the shell tool to read probe.txt. Use apply_patch to create verified.txt containing exactly CTF_SMOKE_LOCAL_FILE_OK followed by a newline. Read verified.txt with the shell tool. Reply exactly CTF_SMOKE_OK. Do not inspect other files or run other commands.'
    cmp -s "$CTF_ROOT/.runtime/smoke/probe.txt" "$CTF_ROOT/.runtime/smoke/verified.txt" || \
      fail 'Smoke did not reproduce the local file content.'
    [ "$(cat "$CTF_ROOT/.runtime/smoke/answer.txt")" = 'CTF_SMOKE_OK' ] || fail 'Smoke final answer mismatch.'
    printf 'Verified OpenRouter inference, shell, apply_patch and tool-result replay.\n'; exit 0 ;;
  team|brrr|run|audit|traffic|patch) ;;
  *) usage; fail "Unknown command: $CTF_COMMAND" ;;
esac

CTF_PROFILE=cheap
case "$CTF_COMMAND" in team|brrr) CTF_PROFILE=team ;; audit|traffic|patch) CTF_PROFILE="$CTF_COMMAND" ;; esac
CTF_WORKSPACE="$CTF_ROOT/workspaces/default"
CTF_EXEC=false
CTF_JSON=false
CTF_NETWORK=false
CTF_OUTPUT=''
CTF_MODEL=''
CTF_EFFORT=''
CTF_PROFILE_GIVEN=false
CTF_PROMPT=''
while [ "$#" -gt 0 ]; do
  case "$1" in
    --workspace|--profile|--output|--model|--effort)
      [ "$#" -ge 2 ] || fail "Missing value for $1"
      case "$1" in
        --workspace) CTF_WORKSPACE="$2" ;;
        --profile) CTF_PROFILE="$2"; CTF_PROFILE_GIVEN=true ;;
        --output) CTF_OUTPUT="$2" ;;
        --model) CTF_MODEL="$2" ;;
        --effort) CTF_EFFORT="$2" ;;
      esac
      shift 2 ;;
    --exec) CTF_EXEC=true; shift ;;
    --network) CTF_NETWORK=true; shift ;;
    --json) CTF_JSON=true; shift ;;
    --) shift; CTF_PROMPT="$*"; break ;;
    -*) fail "Unknown option: $1" ;;
    *) CTF_PROMPT="$*"; break ;;
  esac
done
[ "$CTF_COMMAND" != brrr ] || {
  [ "$CTF_PROFILE_GIVEN" = false ] || printf 'ctf-codex: brrr always runs the team profile; ignoring --profile.\n' >&2
  CTF_PROFILE=team
}
case "$CTF_PROFILE" in team|cheap|audit|traffic|patch|deepseek-cheap|deepseek-audit) ;; *) fail 'Unknown profile.' ;; esac
if [ ! -d "$CTF_WORKSPACE" ] && [ "$CTF_WORKSPACE" = "$CTF_ROOT/workspaces/default" ]; then
  "$CTF_ROOT/bin/ctf-codex" init default >/dev/null
fi
[ -d "$CTF_WORKSPACE" ] || fail 'Workspace does not exist; use init or --workspace.'
if [ -n "$CTF_EFFORT" ]; then
  case "$CTF_EFFORT" in low|medium|high|xhigh|max) ;; *) fail 'Unknown reasoning effort.' ;; esac
fi
if [ -n "$CTF_MODEL" ]; then
  [[ "$CTF_MODEL" =~ ^[a-zA-Z0-9_.~-]+/[a-zA-Z0-9_.:~-]+$ ]] || fail 'Use a complete OpenRouter slug.'
fi
if [ "$CTF_COMMAND" = brrr ]; then
  CTF_PROMPT="$(cat "$CTF_ROOT/prompts/brrr.md")

$CTF_PROMPT"
elif [ "$CTF_COMMAND" != run ]; then
  CTF_PROMPT="$(cat "$CTF_ROOT/prompts/$CTF_COMMAND.md")

$CTF_PROMPT"
fi
setup
"$CTF_ROOT/bin/openrouter-token" >/dev/null || fail 'OpenRouter credential unavailable.'
sanitize_project_config "$CTF_WORKSPACE"
CTF_ARGS=(--no-daemon --strict-config --cd "$CTF_WORKSPACE" --profile "$CTF_PROFILE"
  -c 'model_provider="openrouter"' -c 'model_providers.openrouter.base_url="https://openrouter.ai/api/v1"')
if [ "$CTF_COMMAND" = team ] || [ "$CTF_COMMAND" = brrr ]; then
  CTF_ARGS+=(-c 'features.multi_agent=true' -c 'agents.enabled=true' -c 'agents.max_concurrent_threads_per_session=20')
fi
[ -z "$CTF_MODEL" ] || CTF_ARGS+=(--model "$CTF_MODEL")
[ -z "$CTF_EFFORT" ] || CTF_ARGS+=(-c "model_reasoning_effort=\"$CTF_EFFORT\"")
$CTF_NETWORK && CTF_ARGS+=(-c 'sandbox_workspace_write.network_access=true')
if [ "$CTF_COMMAND" = team ] || [ "$CTF_COMMAND" = brrr ]; then
  mkdir -p "$CTF_WORKSPACE/coordination/inbox" "$CTF_WORKSPACE/flags/inbox"
  if [ "$CTF_COMMAND" = brrr ]; then
    CTF_TEAM_SCOPE='Surge launch: up to twenty spawned agents are authorized; scale only for distinct useful backlog.'
  else
    CTF_TEAM_SCOPE='Team launch: start five workers initially and expand only when distinct useful backlog warrants it.'
  fi
  CTF_PROMPT="$CTF_PROMPT

Repository tooling root: $CTF_ROOT
Use scripts at that absolute root. $CTF_TEAM_SCOPE"
fi
if $CTF_EXEC; then
  CTF_ARGS+=(exec --ephemeral --color never --skip-git-repo-check)
  $CTF_JSON && CTF_ARGS+=(--json)
  [ -z "$CTF_OUTPUT" ] || CTF_ARGS+=(--output-last-message "$CTF_OUTPUT")
elif $CTF_JSON || [ -n "$CTF_OUTPUT" ]; then
  fail '--json and --output require --exec.'
fi
[ -z "$CTF_PROMPT" ] || CTF_ARGS+=("$CTF_PROMPT")
# Credential loading lives in Codex's auth helper, not the agent shell environment.
exec env -u OPENAI_API_KEY -u CODEX_API_KEY CODEX_HOME="$CTF_HOME" codex "${CTF_ARGS[@]}"
