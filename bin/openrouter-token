#!/usr/bin/env bash
# Codex's command-auth helper. Stdout is consumed as a bearer token, never logged.
set -euo pipefail
if [ -n "${OPENROUTER_API_KEY:-}" ]; then
  printf '%s' "$OPENROUTER_API_KEY"
  exit 0
fi
CTF_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CTF_KEY_FILE="$CTF_ROOT/.runtime/secrets/openrouter.key"
if [ ! -f "$CTF_KEY_FILE" ] || [ ! -s "$CTF_KEY_FILE" ]; then
  printf 'Set OPENROUTER_API_KEY or save a private key in .runtime/secrets/openrouter.key\n' >&2
  exit 1
fi
case "$(uname -s)" in
  Darwin) CTF_MODE="$(stat -f '%Lp' "$CTF_KEY_FILE")" ;;
  *) CTF_MODE="$(stat -c '%a' "$CTF_KEY_FILE")" ;;
esac
if [ "$CTF_MODE" != 600 ]; then
  printf 'The OpenRouter key file must have mode 0600.\n' >&2
  exit 1
fi
cat "$CTF_KEY_FILE"
